DISCORD_TOKEN=put-your-bot-token-here

# Optional. If set, slash commands register instantly for this server.
GUILD_ID=

# Discord's Message Content privileged intent must be enabled for random replies.
RANDOM_REPLY_CHANCE=0.08
RANDOM_REPLIES=yay,ok,or,nope

# Sanity CMS assets. If SANITY_PROJECT_ID is empty, the bot uses local/env fallbacks.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2025-01-01
SANITY_USE_CDN=true
SANITY_CACHE_SECONDS=300

# Optional. Only needed if your dataset is private.
SANITY_TOKEN=

# Random GIF trigger responses. KLIPY_API_KEY is required for Response type: Random GIF.
KLIPY_API_KEY=
KLIPY_CLIENT_KEY=muodybot
GIF_RESULT_LIMIT=25
GIF_CONTENT_FILTER=medium

# Late-night VC behavior.
TIME_ZONE=America/New_York
VOICE_JOIN_START_HOUR=23
VOICE_JOIN_END_HOUR=3
VOICE_STAY_MIN_MINUTES=4
VOICE_STAY_MAX_MINUTES=8
VOICE_PAUSE_MIN_SECONDS=8
VOICE_PAUSE_MAX_SECONDS=45
# Optional fixed-length fallback if VOICE_STAY_MIN_MINUTES and VOICE_STAY_MAX_MINUTES are unset.
# VOICE_STAY_MINUTES=5
VOICE_NOISE_DIR=assets/noises
VOICE_RANDOM_JOIN_ENABLED=true
VOICE_MAX_VISITS_PER_NIGHT=1

# Optional. Set to 10 while testing voice joins, then set back to 0.
VOICE_TEST_DELAY_SECONDS=0

# Roblox suggestions.
ROBLOX_SUGGESTION_COUNT=5
