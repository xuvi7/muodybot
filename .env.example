DISCORD_TOKEN=put-your-bot-token-here

# Optional. If set, slash commands register instantly for this server.
GUILD_ID=

# Discord's Message Content privileged intent must be enabled for random replies.
RANDOM_REPLY_CHANCE=0.08
RANDOM_REPLIES=yay,ok,or,nope

# Late-night VC behavior.
TIME_ZONE=America/New_York
VOICE_JOIN_START_HOUR=23
VOICE_JOIN_END_HOUR=3
VOICE_STAY_MINUTES=5
VOICE_NOISE_DIR=assets/noises
VOICE_RANDOM_JOIN_ENABLED=true
VOICE_MAX_VISITS_PER_NIGHT=1

# Optional. Set to 10 while testing voice joins, then set back to 0.
VOICE_TEST_DELAY_SECONDS=0

# Roblox suggestions.
ROBLOX_SUGGESTION_COUNT=5
